{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ES-9 Mixer",
  "version": "0.1.0",
  "identifier": "io.github.wday.es9-mixer",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ES-9 Mixer",
        "width": 1120,
        "height": 700,
        "minWidth": 820,
        "minHeight": 540,
        "label": "main",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "William Day",
    "copyright": "Copyright (c) 2026 William Day. GPL-3.0-only.",
    "shortDescription": "Control surface for the Expert Sleepers ES-9",
    "longDescription": "An alternative control surface for the Expert Sleepers ES-9: matrix mixer, patchbay routing, and 16-channel metering over the module's MIDI SysEx protocol.",
    "licenseFile": "../../LICENSE-GPL-3.0",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    }
  }
}
